{
    "name": "alareqi/filament-tree",
    "type": "library",
    "description": "Tree-structured Eloquent records rendered through native Filament tables.",
    "keywords": ["laravel", "filament", "tree-table"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/actions": "^5.0",
        "filament/forms": "^5.0",
        "filament/support": "^5.0",
        "filament/tables": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "autoload": {
        "psr-4": {
            "Alareqi\\FilamentTree\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alareqi\\FilamentTree\\FilamentTreeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
